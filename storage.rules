rules_version = '2';

// Archivos originales de procedimientos (PDF o imágenes).
service firebase.storage {
  match /b/{bucket}/o {
    function rol() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol;
    }
    match /procedimientos/{archivo} {
      allow read: if request.auth != null && rol() in ['colaborador', 'editor', 'admin'];
      allow write: if request.auth != null && rol() in ['editor', 'admin']
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*'));
    }
  }
}
